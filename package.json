{
  "name": "cyclegauge",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StefanSuess/Cyclegauge.git"
  },
  "bugs": {
    "url": "https://github.com/StefanSuess/Cyclegauge/issues"
  },
  "homepage": "https://github.com/StefanSuess/Cyclegauge#readme",
  "categories": [
    "Other"
  ],
  "keywords": [
    "kiro",
    "credits",
    "usage",
    "forecast",
    "budget"
  ],
  "type": "module",
  "displayName": "Cyclegauge for Kiro IDE",
  "description": "Credit usage & forecasting for Kiro IDE. Unofficial; not affiliated with AWS or Kiro.",
  "publisher": "easykirogauge",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=24.13.0"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cyclegauge.showUsage",
        "title": "Cyclegauge: Show Account Credits"
      },
      {
        "command": "cyclegauge.configureCostOptimizer",
        "title": "Cyclegauge: Configure Cost Optimizer",
        "icon": "$(settings-gear)"
      },
      {
        "command": "cyclegauge.editCostScenario",
        "title": "Cyclegauge: Edit Cost Scenario",
        "icon": "$(edit)"
      },
      {
        "command": "cyclegauge.clearCostInputs",
        "title": "Cyclegauge: Clear Cost Inputs",
        "icon": "$(clear-all)"
      }
    ],
    "configuration": {
      "title": "Cyclegauge",
      "properties": {
        "cyclegauge.sourceRoot": {
          "type": "string",
          "default": "",
          "description": "Kiro IDE data root; leave empty for the platform default."
        },
        "cyclegauge.storageRoot": {
          "type": "string",
          "default": "",
          "description": "Private Cyclegauge storage root; leave empty for the platform default. The default folder keeps its legacy name EasyKiroGauge."
        },
        "cyclegauge.sourceTimezone": {
          "type": "string",
          "default": "",
          "description": "IANA timezone used by offset-free Kiro account logs; leave empty for the device timezone."
        },
        "easykirogauge.sourceRoot": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Deprecated: use cyclegauge.sourceRoot. Still read when the new setting is empty.",
          "description": "Deprecated legacy key for cyclegauge.sourceRoot."
        },
        "easykirogauge.storageRoot": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Deprecated: use cyclegauge.storageRoot. Still read when the new setting is empty.",
          "description": "Deprecated legacy key for cyclegauge.storageRoot."
        },
        "easykirogauge.sourceTimezone": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Deprecated: use cyclegauge.sourceTimezone. Still read when the new setting is empty.",
          "description": "Deprecated legacy key for cyclegauge.sourceTimezone."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "cyclegauge.configureCostOptimizer",
          "when": "activeWebviewPanelId == cyclegauge.usage",
          "group": "navigation@1"
        },
        {
          "command": "cyclegauge.editCostScenario",
          "when": "activeWebviewPanelId == cyclegauge.usage",
          "group": "navigation@2"
        },
        {
          "command": "cyclegauge.clearCostInputs",
          "when": "activeWebviewPanelId == cyclegauge.usage",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "build:extension": "esbuild src/extension/extension.ts --bundle --platform=node --format=cjs --target=node24 --external:vscode --outfile=dist/extension.cjs",
    "package:vsix": "pnpm build:extension && vsce package --no-dependencies --out dist/cyclegauge-0.5.1.vsix"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
