{
  "name": "cyclegauge",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StefanSuess/Cyclegauge.git"
  },
  "bugs": {
    "url": "https://github.com/StefanSuess/Cyclegauge/issues"
  },
  "homepage": "https://github.com/StefanSuess/Cyclegauge#readme",
  "sponsor": {
    "url": "https://ko-fi.com/stefansuess"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "kiro",
    "credits",
    "usage",
    "forecast",
    "budget"
  ],
  "type": "module",
  "displayName": "Cyclegauge for Kiro IDE",
  "description": "Credit usage & forecasting for Kiro IDE. Unofficial; not affiliated with AWS or Kiro.",
  "publisher": "StefanSuess",
  "icon": "assets/branding/cyclegauge-icon-256.png",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=24.13.0"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cyclegauge.showUsage",
        "title": "Cyclegauge: Show Account Credits"
      },
      {
        "command": "cyclegauge.costAdvisor",
        "title": "Cyclegauge: Cost Advisor",
        "icon": "$(lightbulb)"
      },
      {
        "command": "cyclegauge.auditWorkspace",
        "title": "Cyclegauge: Audit Kiro Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "cyclegauge.reviewKiroConfig",
        "title": "Cyclegauge: Review Kiro Steering and Hooks",
        "icon": "$(checklist)"
      },
      {
        "command": "cyclegauge.config.loadWhenNeeded",
        "title": "Review changes…",
        "icon": "$(check)"
      },
      {
        "command": "cyclegauge.config.loadWhenNeededAll",
        "title": "Review changes…",
        "icon": "$(check)"
      },
      {
        "command": "cyclegauge.config.narrowPattern",
        "title": "Narrow the pattern",
        "icon": "$(filter)"
      },
      {
        "command": "cyclegauge.config.runManually",
        "title": "Review changes…",
        "icon": "$(check)"
      },
      {
        "command": "cyclegauge.config.runManuallyAll",
        "title": "Review changes…",
        "icon": "$(check)"
      },
      {
        "command": "cyclegauge.config.disable",
        "title": "Disable",
        "icon": "$(circle-slash)"
      },
      {
        "command": "cyclegauge.config.open",
        "title": "Show file",
        "icon": "$(go-to-file)"
      },
      {
        "command": "cyclegauge.config.preview",
        "title": "Show suggestion",
        "icon": "$(lightbulb)"
      },
      {
        "command": "cyclegauge.copyDiagnostics",
        "title": "Cyclegauge: Copy Diagnostics"
      },
      {
        "command": "cyclegauge.reportProblem",
        "title": "Cyclegauge: Report a Problem"
      },
      {
        "command": "cyclegauge.audit.accept",
        "title": "Review changes…",
        "icon": "$(check)"
      },
      {
        "command": "cyclegauge.audit.dismiss",
        "title": "Not a problem",
        "icon": "$(close)"
      },
      {
        "command": "cyclegauge.audit.reveal",
        "title": "Show file",
        "icon": "$(go-to-file)"
      },
      {
        "command": "cyclegauge.audit.acceptAll",
        "title": "Review changes…",
        "icon": "$(check)"
      },
      {
        "command": "cyclegauge.audit.copy",
        "title": "Copy .kiroignore lines",
        "category": "Cyclegauge",
        "icon": "$(copy)"
      },
      {
        "command": "cyclegauge.audit.clearDismissed",
        "title": "Show hidden items again",
        "category": "Cyclegauge"
      },
      {
        "command": "cyclegauge.audit.show",
        "title": "Cyclegauge: Show Workspace Audit"
      },
      {
        "command": "cyclegauge.audit.resetReminder",
        "title": "Cyclegauge: Reset workspace audit reminder"
      },
      {
        "command": "cyclegauge.share",
        "title": "Cyclegauge: Share Cyclegauge"
      },
      {
        "command": "cyclegauge.support.reset",
        "title": "Cyclegauge: Reset Support Prompts and Summary"
      },
      {
        "command": "cyclegauge.gettingStarted",
        "title": "Cyclegauge: Get Started"
      }
    ],
    "walkthroughs": [
      {
        "id": "cyclegauge.gettingStarted",
        "title": "Get started with Cyclegauge",
        "description": "See your Kiro credits, find files Kiro doesn't need and get warned before credits run out.",
        "steps": [
          {
            "id": "cyclegauge.gettingStarted.credits",
            "title": "See your Kiro credits",
            "description": "The status bar shows how many Kiro credits you have used and whether you are on track until the reset. Open the credit view for the details.\n[Show my credits](command:cyclegauge.showUsage)",
            "media": { "image": "assets/branding/cyclegauge-icon-256.png", "altText": "Cyclegauge icon" }
          },
          {
            "id": "cyclegauge.gettingStarted.audit",
            "title": "Find files Kiro doesn't need",
            "description": "Check this workspace for files Kiro may read but probably doesn't need, like secrets, database dumps or build output. This works right away, without any usage history.\n[Check this workspace](command:cyclegauge.auditWorkspace)",
            "media": { "image": "assets/branding/cyclegauge-icon-256.png", "altText": "Cyclegauge icon" },
            "completionEvents": ["onCommand:cyclegauge.auditWorkspace"]
          },
          {
            "id": "cyclegauge.gettingStarted.budget",
            "title": "Get warned before credits run out",
            "description": "Cyclegauge can tell you when your credits are on course to run out before the reset, and what the overage could cost. It is on by default; you can change it in the settings.\n[Open budget settings](command:workbench.action.openSettings?%5B%22cyclegauge.budget%22%5D)",
            "media": { "image": "assets/branding/cyclegauge-icon-256.png", "altText": "Cyclegauge icon" }
          },
          {
            "id": "cyclegauge.gettingStarted.forecast",
            "title": "When the forecast appears",
            "description": "Cyclegauge learns from your usage over time. A provisional estimate needs about 2 days and 3 updates, a regular forecast 7 days and 8 updates. Nothing to do: keep working in Kiro.",
            "media": { "image": "assets/branding/cyclegauge-icon-256.png", "altText": "Cyclegauge icon" }
          },
          {
            "id": "cyclegauge.gettingStarted.sessionHints",
            "title": "Hints from your latest Kiro session",
            "description": "On macOS, Windows and Linux (Windows and Linux not yet verified natively), Cyclegauge tells you when your most recent Kiro session in this workspace is nearly full, or set to a model Kiro lists above Auto's credit rate. To find the newest session of your folder it parses up to 20 recently changed sessions' session.json files (including titles and workspace paths) in memory on your computer, then loads up to the last 256 KiB of that session's conversation file (may contain prompts and replies) into memory. It keeps only that session's model, context percentage and time; nothing is stored or sent. It is on by default; you can turn it off in the settings.\n[Open session hint settings](command:workbench.action.openSettings?%5B%22cyclegauge.sessionHints%22%5D)",
            "media": { "image": "assets/branding/cyclegauge-icon-256.png", "altText": "Cyclegauge icon" }
          }
        ]
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "cyclegauge.auditView",
          "name": "Kiro Workspace Audit"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cyclegauge.auditView",
        "contents": "Check which files in this workspace Kiro can read but probably doesn't need — like secrets, database dumps or build output — and which Steering and Hooks add avoidable context or credit use. Cyclegauge suggests changes; nothing changes until you save.\n[Check workspace](command:cyclegauge.auditWorkspace)"
      }
    ],
    "configuration": {
      "title": "Cyclegauge",
      "properties": {
        "cyclegauge.sourceRoot": {
          "type": "string",
          "default": "",
          "description": "For testing and demos with synthetic logs only. Leave empty: Cyclegauge then reads Kiro's standard data folder.",
          "scope": "machine"
        },
        "cyclegauge.storageRoot": {
          "type": "string",
          "default": "",
          "description": "Private Cyclegauge storage folder. Leave empty to use the editor's standard per-extension storage.",
          "scope": "machine"
        },
        "cyclegauge.sourceTimezone": {
          "type": "string",
          "default": "",
          "description": "IANA timezone used by offset-free Kiro account logs; leave empty for the device timezone.",
          "scope": "machine"
        },
        "cyclegauge.auditReminderDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 365,
          "description": "Remind you to audit a workspace after this many days. 0 turns reminders off.",
          "scope": "application"
        },
        "cyclegauge.auditAutomatically": {
          "type": "string",
          "default": "off",
          "enum": ["off", "onOpen", "onOpenAndChanges"],
          "enumDescriptions": [
            "Only remind you; never run the audit by itself.",
            "When a trusted workspace opens, re-run an audit that is more than one day old.",
            "As onOpen, and re-check when a file matching the audit's own name patterns appears (notifies at most once a day, only for new secret files)."
          ],
          "description": "Run the workspace audit automatically in trusted workspaces (same limits; nothing is written or sent). The earlier value true means onOpen.",
          "scope": "application"
        },
        "cyclegauge.supportPrompts": {
          "type": "boolean",
          "default": true,
          "description": "Occasionally ask whether you'd rate, star or support Cyclegauge, and add the Open VSX link text to the shareable cycle recap. Also covers one-time feature offers, such as turning on the automatic Kiro Steering and Hooks review.",
          "scope": "application"
        },
        "cyclegauge.configReviewAutomatically": {
          "type": "string",
          "default": "off",
          "enum": ["off", "onOpen", "onOpenAndChanges"],
          "enumDescriptions": [
            "Only when you run Cyclegauge: Review Kiro Steering and Hooks.",
            "Once per window, shortly after a trusted workspace opens.",
            "As onOpen, and again after AGENTS.md, .kiro/steering/*.md or .kiro/hooks/*.json change (a notice only for a kind of finding not yet seen in this window)."
          ],
          "description": "Review Kiro Steering and Hooks automatically in trusted local workspaces. Uses the same bounded reads as the manual review and reads nothing else; nothing is written or sent. Only your user setting counts.",
          "scope": "application"
        },
        "cyclegauge.budgetWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show a notice when your reported Kiro credits are on course to run out before the reset, or when usage passes the percent below or reaches the limit (each at most once per billing cycle).",
          "scope": "application"
        },
        "cyclegauge.sessionHints": {
          "type": "boolean",
          "default": true,
          "description": "On macOS, Windows and Linux (Windows and Linux not yet verified natively), show a notice when your most recent Kiro session in this workspace is nearly full or set to a model Kiro lists above Auto's credit rate. This parses up to 20 recently changed sessions' session.json files (each whole, in memory, including titles and workspace paths) to find the newest session of your folder, then loads up to the last 256 KiB of that session's conversation file (may contain prompts and replies) into memory. It keeps only that session's model, context percentage and time (read-only, nothing stored or sent). Turn off to stop all reading.",
          "scope": "application"
        },
        "cyclegauge.budgetWarningPercent": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "Show a budget notice once you have used this percent of your reported Kiro credits. 0 turns this notice off.",
          "scope": "application"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "cyclegauge.costAdvisor",
          "when": "activeWebviewPanelId == cyclegauge.usage",
          "group": "navigation@0"
        }
      ],
      "view/title": [
        {
          "command": "cyclegauge.auditWorkspace",
          "when": "view == cyclegauge.auditView",
          "group": "navigation@1"
        },
        {
          "command": "cyclegauge.audit.clearDismissed",
          "when": "view == cyclegauge.auditView",
          "group": "1_actions@1"
        }
      ],
      "view/item/context": [
        {
          "command": "cyclegauge.audit.acceptAll",
          "when": "view == cyclegauge.auditView && viewItem == group-exclude",
          "group": "inline@1"
        },
        {
          "command": "cyclegauge.audit.acceptAll",
          "when": "view == cyclegauge.auditView && viewItem == group-exclude",
          "group": "1_apply@1"
        },
        {
          "command": "cyclegauge.audit.copy",
          "when": "view == cyclegauge.auditView && viewItem == group-exclude",
          "group": "2_copy@1"
        },
        {
          "command": "cyclegauge.audit.accept",
          "when": "view == cyclegauge.auditView && viewItem == finding-suggestible",
          "group": "inline@1"
        },
        {
          "command": "cyclegauge.audit.dismiss",
          "when": "view == cyclegauge.auditView && viewItem =~ /^finding/",
          "group": "inline@2"
        },
        {
          "command": "cyclegauge.audit.reveal",
          "when": "view == cyclegauge.auditView && viewItem =~ /^finding/",
          "group": "inline@3"
        },
        {
          "command": "cyclegauge.config.loadWhenNeededAll",
          "when": "view == cyclegauge.auditView && viewItem == config-group-load",
          "group": "inline@1"
        },
        {
          "command": "cyclegauge.config.loadWhenNeededAll",
          "when": "view == cyclegauge.auditView && viewItem == config-group-load",
          "group": "1_apply@1"
        },
        {
          "command": "cyclegauge.config.runManuallyAll",
          "when": "view == cyclegauge.auditView && viewItem == config-group-run",
          "group": "inline@1"
        },
        {
          "command": "cyclegauge.config.runManuallyAll",
          "when": "view == cyclegauge.auditView && viewItem == config-group-run",
          "group": "1_apply@1"
        },
        {
          "command": "cyclegauge.config.loadWhenNeeded",
          "when": "view == cyclegauge.auditView && viewItem == config-steering-always",
          "group": "inline@1"
        },
        {
          "command": "cyclegauge.config.open",
          "when": "view == cyclegauge.auditView && viewItem == config-steering-always",
          "group": "inline@2"
        },
        {
          "command": "cyclegauge.config.loadWhenNeeded",
          "when": "view == cyclegauge.auditView && viewItem == config-steering-always",
          "group": "1_config@1"
        },
        {
          "command": "cyclegauge.config.open",
          "when": "view == cyclegauge.auditView && viewItem == config-steering-always",
          "group": "1_config@2"
        },
        {
          "command": "cyclegauge.config.runManually",
          "when": "view == cyclegauge.auditView && viewItem == config-hook",
          "group": "inline@1"
        },
        {
          "command": "cyclegauge.config.open",
          "when": "view == cyclegauge.auditView && viewItem == config-hook",
          "group": "inline@2"
        },
        {
          "command": "cyclegauge.config.runManually",
          "when": "view == cyclegauge.auditView && viewItem == config-hook",
          "group": "1_config@1"
        },
        {
          "command": "cyclegauge.config.disable",
          "when": "view == cyclegauge.auditView && viewItem == config-hook",
          "group": "1_config@2"
        },
        {
          "command": "cyclegauge.config.open",
          "when": "view == cyclegauge.auditView && viewItem == config-hook",
          "group": "1_config@3"
        },
        {
          "command": "cyclegauge.config.narrowPattern",
          "when": "view == cyclegauge.auditView && viewItem == config-steering-match",
          "group": "inline@1"
        },
        {
          "command": "cyclegauge.config.open",
          "when": "view == cyclegauge.auditView && viewItem == config-steering-match",
          "group": "inline@2"
        },
        {
          "command": "cyclegauge.config.narrowPattern",
          "when": "view == cyclegauge.auditView && viewItem == config-steering-match",
          "group": "1_config@1"
        },
        {
          "command": "cyclegauge.config.open",
          "when": "view == cyclegauge.auditView && viewItem == config-steering-match",
          "group": "1_config@2"
        },
        {
          "command": "cyclegauge.config.open",
          "when": "view == cyclegauge.auditView && viewItem == config-agents",
          "group": "inline@1"
        },
        {
          "command": "cyclegauge.config.preview",
          "when": "view == cyclegauge.auditView && viewItem == config-finding",
          "group": "inline@1"
        },
        {
          "command": "cyclegauge.config.preview",
          "when": "view == cyclegauge.auditView && viewItem == config-finding",
          "group": "1_config@1"
        }
      ],
      "commandPalette": [
        {
          "command": "cyclegauge.audit.accept",
          "when": "false"
        },
        {
          "command": "cyclegauge.audit.acceptAll",
          "when": "false"
        },
        {
          "command": "cyclegauge.audit.dismiss",
          "when": "false"
        },
        {
          "command": "cyclegauge.audit.reveal",
          "when": "false"
        },
        {
          "command": "cyclegauge.config.loadWhenNeeded",
          "when": "false"
        },
        {
          "command": "cyclegauge.config.loadWhenNeededAll",
          "when": "false"
        },
        {
          "command": "cyclegauge.config.narrowPattern",
          "when": "false"
        },
        {
          "command": "cyclegauge.config.runManually",
          "when": "false"
        },
        {
          "command": "cyclegauge.config.runManuallyAll",
          "when": "false"
        },
        {
          "command": "cyclegauge.config.disable",
          "when": "false"
        },
        {
          "command": "cyclegauge.config.open",
          "when": "false"
        },
        {
          "command": "cyclegauge.config.preview",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "demo:setup": "node --disable-warning=ExperimentalWarning scripts/demo/setup.mjs",
    "test:host": "node --disable-warning=ExperimentalWarning scripts/test-extension-host.ts",
    "test": "node --disable-warning=ExperimentalWarning --test tests/unit/*.test.ts",
    "test:coverage": "node --disable-warning=ExperimentalWarning --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=80 --test tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.webview.json",
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "build:extension": "node --disable-warning=ExperimentalWarning scripts/build-extension.ts dist/extension.cjs",
    "package:vsix": "pnpm build:extension && vsce package --no-dependencies --out dist/",
    "test:release": "node --disable-warning=ExperimentalWarning --test tests/release/*.test.ts",
    "release:build": "node --disable-warning=ExperimentalWarning scripts/release/build-vsix.ts",
    "release:verify": "node --disable-warning=ExperimentalWarning scripts/release/verify-vsix.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0"
  },
  "preview": true
}
